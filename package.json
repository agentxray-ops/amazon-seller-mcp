{
  "name": "agentxray-mcp",
  "version": "2.0.0",
  "description": "Amazon seller MCP server: reads your Amazon settlement reports locally and returns what Amazon actually settled (sales, every fee, refunds, net, profit per SKU) in exact cents. Optional: add live AgentXray data (orders, ads, stock) with a token.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "agentxray-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && node scripts/postbuild.mjs",
    "prepare": "npm run build",
    "start": "node dist/index.js",
    "test": "npm run build && node --test test/*.test.mjs",
    "prebuild": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  },
  "homepage": "https://agentxray.ai/amazon-mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agentxray-ops/amazon-seller-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/agentxray-ops/amazon-seller-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "amazon",
    "amazon-seller-central",
    "amazon-settlement-report",
    "amazon-fba",
    "profit",
    "sp-api",
    "claude",
    "chatgpt"
  ],
  "author": "Avanta Global EOOD (AgentXray)"
}
